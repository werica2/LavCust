@startuml
title LavCust - Diagrama Entidade-Relacionamento (DER)

hide circle
skinparam linetype ortho
skinparam classAttributeIconSize 0

entity "USUARIOS (users)" as users {
  * id : INTEGER <<PK>>
  --
  name : TEXT
  email : TEXT <<UNIQUE>>
  password_hash : TEXT
  created_at : TEXT
}

entity "DESPESAS (expenses)" as expenses {
  * id : INTEGER <<PK>>
  --
  user_id : INTEGER <<FK>>
  culture : TEXT
  harvest : TEXT
  category : TEXT
  description : TEXT
  amount : REAL
  planned_amount : REAL
  expense_date : TEXT
  created_at : TEXT
}

entity "VENDAS (sales)" as sales {
  * id : INTEGER <<PK>>
  --
  user_id : INTEGER <<FK>>
  culture : TEXT
  harvest : TEXT
  quantity : REAL
  price_per_bag : REAL
  total : REAL
  sale_date : TEXT
  created_at : TEXT
}

users ||--o{ expenses : registra
users ||--o{ sales : realiza

note right of sales
  quantity = quantidade de sacas
  price_per_bag = preco por saca
  total = valor total da venda
end note

@enduml
